[
  {
    "name": "capture_line",
    "patterns": [
      {
        "pattern": "^\\s*\\w[^:]*:\\s+value\\s+\\d+ig/ton",
        "type": "regex"
      },
      {
        "pattern": "^\\s*(?:\\d+%\\s+Net:|Efficiency:|Net:|Spread:|Stock:|current\\s+-?\\d+/min|consumption\\s+\\d+)",
        "type": "regex"
      },
      {
        "pattern": "^\\s*\\w[^:]*:\\s+production\\s+\\d+,",
        "type": "regex"
      }
    ]
  },
  {
    "name": "error_invalid_planet",
    "patterns": [
      {
        "pattern": "That doesn't seem to be either a commodity group, or the name of a planet!",
        "type": "substring"
      },
      {
        "pattern": "I don't seem to recognise that planet name!",
        "type": "substring"
      }
    ]
  },
  {
    "name": "error_not_owner",
    "patterns": [
      {
        "pattern": "You don't own the exchange on this planet!",
        "type": "substring"
      }
    ]
  },
  {
    "name": "exchange_header",
    "patterns": [
      {
        "pattern": "exchange - all products:",
        "type": "substring"
      }
    ]
  },
  {
    "name": "exchange_summary",
    "patterns": [
      {
        "pattern": "^\\s*\\d+ commodities,",
        "type": "regex"
      }
    ]
  },
  {
    "name": "production_header",
    "patterns": [
      {
        "pattern": "exchange - production and consumption:",
        "type": "substring"
      }
    ]
  },
  { "name": "capture_blank", "patterns": [{ "pattern": "^\\s*$", "type": "regex" }] }
]
